#!name=YouTube Ultimate - Safari
#!desc=Loon macOS 与 Safari 专用。净化 YouTube 播放、首页、搜索、Shorts 和推荐接口中的广告数据，并清理网页残留广告；不解密或阻断 googlevideo 视频流。
#!author=Giu-zhao
#!homepage=https://github.com/Giu-zhao/Loon_plugin
#!icon=https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/icon/04ProxySoft/youtube(4).png
#!system=macOS
#!loon_version=3.5.1(983)
#!tag=YouTube,Safari,AdBlock
#!type=normal

[Argument]
enabled = switch,true,tag=总开关,desc=启用 YouTube 网页广告净化
page_enhance = switch,true,tag=网页增强,desc=清理页面广告容器并点击可跳过广告按钮
debug = switch,false,tag=调试日志,desc=只记录端点和清理数量，不记录响应内容

[Rule]
# 仅让 YouTube 页面与 JSON API 的 QUIC 回退到 TCP/TLS，便于 MitM 响应脚本工作。
# 不处理 googlevideo.com，视频媒体流保持原样。
AND,((PROTOCOL,QUIC),(DOMAIN-SUFFIX,youtube.com)),REJECT
AND,((PROTOCOL,QUIC),(DOMAIN,youtubei.googleapis.com)),REJECT

[Rewrite]
# 只拒绝 YouTube 自身明确的广告统计与页面广告端点，不做跨站广告域名封锁。
request if ${url} ~= /^https:\/\/(www\.|s\.)?youtube\.com\/api\/stats\/ads([\/?].*)?$/i then reject(200)
request if ${url} ~= /^https:\/\/(www\.|s\.)?youtube\.com\/pagead([\/?].*)?$/i then reject(200)
request if ${url} ~= /^https:\/\/s\.youtube\.com\/api\/stats\/qoe\?.*adcontext.*$/i then reject(200)

[Script]
response if ${url} ~= /^https:\/\/(www\.youtube\.com|youtubei\.googleapis\.com)\/youtubei\/v1\/player([\/?].*)?$/i then script("https://raw.githubusercontent.com/Giu-zhao/Loon_plugin/main/YouTubeUltimatePlayer.js?v=1.0.0", {${enabled}, ${debug}}) with enable=${enabled}, tag="YT Ultimate Player", timeout=10, requires_body=true
response if ${url} ~= /^https:\/\/(www\.youtube\.com|youtubei\.googleapis\.com)\/youtubei\/v1\/(browse|search|guide)([\/?].*)?$/i then script("https://raw.githubusercontent.com/Giu-zhao/Loon_plugin/main/YouTubeUltimateBrowse.js?v=1.0.0", {${enabled}, ${debug}}) with enable=${enabled}, tag="YT Ultimate Browse", timeout=10, requires_body=true
response if ${url} ~= /^https:\/\/(www\.youtube\.com|youtubei\.googleapis\.com)\/youtubei\/v1\/(next|get_watch)([\/?].*)?$/i then script("https://raw.githubusercontent.com/Giu-zhao/Loon_plugin/main/YouTubeUltimateNext.js?v=1.0.0", {${enabled}, ${debug}}) with enable=${enabled}, tag="YT Ultimate Next", timeout=10, requires_body=true
response if ${url} ~= /^https:\/\/((www|m)\.)?youtube\.com\/($|\?.*|watch(\?.*)?|results(\?.*)?|feed(\/.*)?|shorts(\/.*)?|playlist(\?.*)?|channel\/.*|@.*|hashtag\/.*|gaming.*|live.*)$/i then script("https://raw.githubusercontent.com/Giu-zhao/Loon_plugin/main/YouTubeUltimatePage.js?v=1.0.0", {${enabled}, ${page_enhance}, ${debug}}) with enable=${enabled}, tag="YT Ultimate Page", timeout=10, requires_body=true

[Mitm]
hostname = youtube.com, www.youtube.com, m.youtube.com, s.youtube.com, youtubei.googleapis.com
