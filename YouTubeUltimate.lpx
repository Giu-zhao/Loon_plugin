#!name=YouTube Ultimate
#!desc=Loon iOS、iPadOS 与 macOS 的 YouTube/YouTube Music App 二进制增强及 Safari 网页广告净化；不伪造 Premium 或下载权益。
#!author=Giu-zhao
#!homepage=https://github.com/Giu-zhao/Loon_plugin
#!icon=https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/icon/04ProxySoft/youtube(4).png
#!system=iOS,iPadOS,macOS
#!loon_version=3.5.1(983)
#!tag=YouTube,Safari,AdBlock
#!type=normal

[Argument]
enabled = switch,true,tag=总开关,desc=启用 YouTube Ultimate
web_enhance = switch,true,tag=网页增强,desc=清理 Safari 页面广告容器
app_enhance = switch,true,tag=App 增强,desc=启用 YouTube 与 YouTube Music App 功能
blockUpload = switch,false,tag=隐藏上传按钮,desc=隐藏 YouTube 底栏上传按钮
blockShorts = switch,false,tag=隐藏 Shorts 按钮,desc=隐藏 YouTube 底栏 Shorts 按钮
blockImmersive = switch,false,tag=隐藏选段按钮,desc=隐藏 YouTube Music 底栏选段按钮
debug = switch,false,tag=调试日志,desc=只记录端点、处理类型和数量

[Rule]
AND,((PROTOCOL,QUIC),(DOMAIN-SUFFIX,youtube.com)),REJECT
AND,((PROTOCOL,QUIC),(DOMAIN,youtubei.googleapis.com)),REJECT
AND,((PROTOCOL,QUIC),(DOMAIN-SUFFIX,googlevideo.com)),REJECT

[Script]
request if ${url} ~= /^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event(\/|\?|$)/i then script("https://raw.githubusercontent.com/Giu-zhao/Loon_plugin/main/YouTubeUltimateAppRequest.js?v=2.1.0", {${blockUpload}, ${blockShorts}, ${blockImmersive}}) with enable=${app_enhance}, tag="YT Ultimate Music Request", timeout=10, requires_body=true, binary_body_mode=true
request if ${url} ~= /^https:\/\/[^\/]+\.googlevideo\.com\/initplayback(\/|\?|$)/i then script("https://raw.githubusercontent.com/Giu-zhao/Loon_plugin/main/YouTubeUltimateAppRequest.js?v=2.1.0", {${blockUpload}, ${blockShorts}, ${blockImmersive}}) with enable=${app_enhance}, tag="YT Ultimate Music Stream", timeout=10, requires_body=true, binary_body_mode=true
response if ${url} ~= /^https:\/\/(www\.youtube\.com|youtubei\.googleapis\.com)\/youtubei\/v1\/(player|browse|next|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch)(\/|\?|$)/i then script("https://raw.githubusercontent.com/Giu-zhao/Loon_plugin/main/YouTubeUltimateAPI.js?v=2.1.3", {${enabled}, ${web_enhance}, ${app_enhance}, ${blockUpload}, ${blockShorts}, ${blockImmersive}, ${debug}}) with enable=${enabled}, tag="YT Ultimate API", timeout=10, requires_body=true, binary_body_mode=true
response if ${url} ~= /^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(config|log_event)(\/|\?|$)/i then script("https://raw.githubusercontent.com/Giu-zhao/Loon_plugin/main/YouTubeUltimateAppOnesie.js?v=2.1.0", {${blockUpload}, ${blockShorts}, ${blockImmersive}}) with enable=${app_enhance}, tag="YT Ultimate Music Keys", timeout=10, requires_body=true, binary_body_mode=true
response if ${url} ~= /^https:\/\/((www|m)\.)?youtube\.com\//i then script("https://raw.githubusercontent.com/Giu-zhao/Loon_plugin/main/YouTubeUltimatePage.js?v=2.0.0", {${enabled}, ${web_enhance}, ${debug}}) with enable=${enabled}, tag="YT Ultimate Page", timeout=10, requires_body=true

[Mitm]
hostname = youtube.com, www.youtube.com, m.youtube.com, s.youtube.com, youtubei.googleapis.com, *.googlevideo.com
