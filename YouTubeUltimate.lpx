#!name=YouTube Ultimate
#!desc=Loon iOS、iPadOS 与 macOS 的 YouTube/YouTube Music App 二进制增强及 Safari 网页广告净化；不伪造 Premium 或下载权益。
#!author=Giu-zhao
#!homepage=https://github.com/Giu-zhao/Loon_plugin
#!icon=https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/icon/04ProxySoft/youtube(4).png
#!system=iOS,iPadOS,macOS
#!tag=YouTube,Safari,AdBlock
#!type=normal

[Argument]
enabled = switch,true,tag=总开关,desc=启用 YouTube Ultimate
web_enhance = switch,true,tag=网页增强,desc=清理 Safari 页面广告容器
app_enhance = switch,true,tag=App 增强,desc=启用 YouTube 与 YouTube Music App 功能
blockUpload = switch,false,tag=隐藏上传按钮,desc=隐藏 YouTube 底栏上传按钮
blockShorts = switch,false,tag=隐藏 Shorts 按钮,desc=隐藏 YouTube 底栏 Shorts 按钮
blockImmersive = switch,false,tag=隐藏选段按钮,desc=隐藏 YouTube Music 底栏选段按钮
captionLang = select,zh-Hans,zh-Hant,ja,ko,en,off,tag=字幕翻译语言,desc=选择字幕翻译目标语言
lyricLang = select,zh-Hans,zh-Hant,ja,ko,en,off,tag=歌词翻译语言,desc=选择歌词翻译目标语言
debug = switch,false,tag=调试日志,desc=只记录端点、处理类型和数量

[Rule]
AND,((PROTOCOL,QUIC),(DOMAIN-SUFFIX,youtube.com)),REJECT
AND,((PROTOCOL,QUIC),(DOMAIN,youtubei.googleapis.com)),REJECT
AND,((PROTOCOL,QUIC),(DOMAIN-SUFFIX,googlevideo.com)),REJECT

[Rewrite]
# 仅拒绝带明确广告标记 &oad 的 initplayback；普通 videoplayback 与整个 googlevideo 域名不拒绝。
^https:\/\/[^\/]+\.googlevideo\.com\/initplayback\?.*\&oad(?:=|&|$).*$ reject

[Script]
http-response ^https:\/\/(?:www\.youtube\.com|youtubei\.googleapis\.com)\/youtubei\/v1\/(?:player|browse|next|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch)(?:[\/?].*)?$ script-path=https://raw.githubusercontent.com/Giu-zhao/Loon_plugin/main/YouTubeUltimateAPI.js?v=2.0.0,requires-body=true,binary-body-mode=true,timeout=10,tag=YT Ultimate API,argument=[{enabled},{web_enhance},{app_enhance},{blockUpload},{blockShorts},{blockImmersive},{captionLang},{lyricLang},{debug}],enable={enabled}
http-response ^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(?:config|log_event)(?:[\/?].*)?$ script-path=https://raw.githubusercontent.com/Giu-zhao/Loon_plugin/main/YouTubeUltimateAppOnesie.js?v=2.0.0,requires-body=true,binary-body-mode=true,timeout=10,tag=YT Ultimate Onesie,argument=[{captionLang},{blockUpload},{blockShorts},{blockImmersive}],enable={app_enhance}
http-response ^https:\/\/(?:(?:www|m)\.)?youtube\.com\/(?:$|\?.*|watch(?:\?.*)?|results(?:\?.*)?|feed(?:\/.*)?|shorts(?:\/.*)?|playlist(?:\?.*)?|channel\/.*|@.*|hashtag\/.*|gaming.*|live.*)$ script-path=https://raw.githubusercontent.com/Giu-zhao/Loon_plugin/main/YouTubeUltimatePage.js?v=2.0.0,requires-body=true,timeout=10,tag=YT Ultimate Page,argument=[{enabled},{web_enhance},{debug}],enable={enabled}

[Mitm]
hostname = youtube.com, www.youtube.com, m.youtube.com, s.youtube.com, youtubei.googleapis.com, *.googlevideo.com
