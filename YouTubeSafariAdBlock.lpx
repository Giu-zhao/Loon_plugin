#!name=YouTube Safari-Style AdBlock
#!desc=YouTube web ad blocking for Loon. Uses safe rules plus a Safari-style watch-page ad skipper. No player API rewriting, no googlevideo blocking.
#!author=Codex
#!tag=YouTube, Safari, AdBlock
#!system=iOS, iPadOS, macOS
#!loon_version=3.4.0
#!icon=https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/icon/04ProxySoft/youtube(4).png

[Rule]
# Force YouTube web traffic away from QUIC so rule matching and proxy behavior stay consistent.
# This does not block video content; browsers fall back to HTTPS over TCP.
AND, ((PROTOCOL, QUIC), (DOMAIN-SUFFIX, youtube.com)), REJECT
AND, ((PROTOCOL, QUIC), (DOMAIN-SUFFIX, googlevideo.com)), REJECT
AND, ((PROTOCOL, QUIC), (DOMAIN-SUFFIX, ytimg.com)), REJECT

# Google ad delivery domains commonly used around YouTube and web ads.
DOMAIN-SUFFIX, doubleclick.net, REJECT
DOMAIN-SUFFIX, googleadservices.com, REJECT
DOMAIN-SUFFIX, googlesyndication.com, REJECT
DOMAIN-SUFFIX, googletagservices.com, REJECT
DOMAIN-SUFFIX, 2mdn.net, REJECT
DOMAIN-SUFFIX, adservice.google.com, REJECT
DOMAIN-SUFFIX, pagead2.googlesyndication.com, REJECT
DOMAIN-SUFFIX, googleads.g.doubleclick.net, REJECT
DOMAIN-SUFFIX, dartsearch.net, REJECT

# YouTube web ad and measurement endpoints. These are intentionally narrow and do not touch player, next, or googlevideo.
DOMAIN, static.doubleclick.net, REJECT
DOMAIN, tpc.googlesyndication.com, REJECT
DOMAIN, securepubads.g.doubleclick.net, REJECT
DOMAIN, pubads.g.doubleclick.net, REJECT
DOMAIN, pagead2.googlesyndication.com, REJECT
DOMAIN, googleads.g.doubleclick.net, REJECT

[Script]
# Safari-style page helper: only injects on YouTube watch pages, never touches youtubei/player or googlevideo.
http-response ^https:\/\/((www|m)\.)?youtube\.com\/watch(\?.*)?$ script-path=https://raw.githubusercontent.com/Giu-zhao/Loon_plugin/main/YouTubeSafariAdSkipper.js?v=20260806-hostfix1, requires-body=true, timeout=10, tag=YouTube Safari Ad Skipper, enable=true

[MitM]
hostname = youtube.com, www.youtube.com, m.youtube.com
