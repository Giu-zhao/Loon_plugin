#!name=Local Service Direct
#!desc=macOS 常用服务直连规则：Apple、微信与腾讯、远程控制、旅行服务。保留原分流范围，不包含个人服务器、节点地址或凭据。
#!author=Giu-zhao
#!homepage=https://github.com/Giu-zhao/Loon_plugin
#!system=macOS
#!tag=Routing,DIRECT
#!type=normal

[Rule]
# 旅行服务
PROCESS-NAME,trip,DIRECT
PROCESS-NAME,fantopia,DIRECT
DOMAIN-SUFFIX,trip.com,DIRECT
DOMAIN-SUFFIX,ctrip.com,DIRECT
DOMAIN-SUFFIX,ctrip.com.cn,DIRECT
DOMAIN-SUFFIX,fantopia.io,DIRECT
DOMAIN-SUFFIX,fantopia.co,DIRECT

